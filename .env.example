GOOGLE_API_KEY=your_google_key_here
EDENAI_API_KEY=your_edenai_key_here
OPENAI_API_KEY=your_openai_key_here

# Optional: web_search agent tool, provider "tavily" (the fenced web-search arm).
# The "duckduckgo" provider is keyless, so smoke runs need no key.
# TAVILY_API_KEY=your_tavily_key_here

# Optional: override the Ollama host (e.g. WSL → Windows host, or a remote box).
# Used when a config doesn't set generation/agent base_url explicitly. Unset →
# http://localhost:11434.
# OLLAMA_BASE_URL=http://localhost:11434
